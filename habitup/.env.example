# =============================================================================
# HabitUp — Variables de Entorno
# Copia este fichero a .env.local y completa los valores.
# NUNCA commits .env*.local al repositorio.
# =============================================================================

# --- Supabase (obligatorio) ------------------------------------------------
# URL del proyecto Supabase (Dashboard > Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key pública del proyecto (Dashboard > Settings > API > anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Project ID (Dashboard > Settings > General > Reference ID)
EXPO_PUBLIC_SUPABASE_PROJECT_ID=your-supabase-project-ref

# --- Stripe (opcional para MVP, necesario para pagos) ----------------------
# Publishable key de Stripe (Dashboard > API keys > pk_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_optional_for_future_payments

# --- Expo Notifications (opcional para MVP) --------------------------------
# Project ID de tu proyecto Expo (expo.dev > Dashboard > Project > Configuration)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# =============================================================================
# Variables SOLO para Edge Functions (no se usan en la app movil)
# Se inyectan via Supabase Dashboard > Edge Functions > Secrets.
# o mediante:  supabase secrets set KEY=value
# =============================================================================
STRIPE_SECRET_KEY=sk_test_only_for_edge_functions
STRIPE_WEBHOOK_SECRET=whsec_only_for_edge_functions

# --- Push notifications (necesario para enviar pushes) -----------------------
# Secreto compartido entre la DB (trigger) y la Edge Function.
# Debe ser el MISMO valor en:
#   1. DB:  ALTER DATABASE postgres SET app.settings.push_secret_key TO '<valor>';
#   2. EF:  supabase secrets set PUSH_SECRET_KEY=<valor>
# Genera un valor seguro:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_SECRET_KEY=generate-a-random-64-char-hex-string

# Necesaria para que la Edge Function pueda marcar tokens invalidos en la DB
# (service_role tiene permisos para llamar a record_push_error)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
