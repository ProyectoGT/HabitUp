{
  "name": "habitup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "npx expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Tests pendientes: instalar Jest/RNTL — ver QA_CHECKLIST.md\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --project-id \"$EXPO_PUBLIC_SUPABASE_PROJECT_ID\" > src/types/database.types.ts",
    "supabase:types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "supabase:link": "supabase link --project-ref \"$EXPO_PUBLIC_SUPABASE_PROJECT_ID\"",
    "supabase:test:rls": "npx tsx supabase/tests/rls/run.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@sentry/react-native": "~6.7.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.104.1",
    "babel-preset-expo": "~54.0.10",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.73.1",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.5.0",
    "supabase": "^2.101.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
