# Normalización de finales de línea.
# Git almacena todo en LF; en Windows se hace checkout con CRLF donde corresponde.
* text=auto eol=lf

# Archivos que deben conservar CRLF en Windows
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binarios: nunca tocar
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.keystore binary
*.jks    binary
